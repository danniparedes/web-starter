# Root rules (Apache). On nginx these do nothing: see docs/2026-11-13_Hosting-Profiles.md.
Options -Indexes
DirectoryIndex index.php index.html

# Clean URLs (config/site.php: 'routing' => 'pretty'): /contact -> index.php?p=contact
# NOT tested on a real Apache yet (neither are the two robots/sitemap rules): check on the first host. Needs mod_rewrite.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # /robots.txt and /sitemap.xml are built from config/site.php (a real file with the same name wins)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^robots\.txt$ php/handlers/robots.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^sitemap\.xml$ php/handlers/sitemap.php [L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ $1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9-]+)$ index.php?p=$1 [L,QSA]
</IfModule>

# Hide dot files (.git, .env, .htaccess...) from visitors
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Internal PHP files are loaded by other PHP files, never opened in the browser
<FilesMatch "^(bootstrap|dev-router)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve local secrets or logs even if a folder rule is missing
<FilesMatch "(site\.local\.php|\.log|\.jsonl|\.csv)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
